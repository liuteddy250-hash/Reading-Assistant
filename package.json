{
  "name": "english-reader",
  "version": "1.5.1",
  "private": true,
  "description": "English reading assistant: upload PDF books, pre-study difficult sentences and words, then read with highlights and look-up.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:init": "node scripts/init-db.mjs",
    "db:studio": "prisma studio",
    "dict:import": "node scripts/import-ecdict.mjs",
    "sample:pdf": "node scripts/make-sample-pdf.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:llm": "node scripts/check-llm-fallback.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.13",
    "next": "16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
