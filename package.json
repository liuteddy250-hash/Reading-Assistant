{
  "name": "english-reader",
  "version": "1.0.0",
  "private": true,
  "description": "English reading assistant: upload PDF books, pre-study difficult sentences and words, then read with highlights and look-up.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:init": "node scripts/init-db.mjs",
    "db:studio": "prisma studio",
    "sample:pdf": "node scripts/make-sample-pdf.mjs",
    "smoke:db": "node scripts/smoke-db.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
