# ---------------------------------------------------------------------------
# 1) 数据库（默认 SQLite，文件位于 prisma/dev.db，无需安装数据库）
#    换成 Postgres/MySQL 时：修改 prisma/schema.prisma 的 provider，
#    并把这里改成 postgresql://user:pass@host:5432/db?schema=public
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# 2) 会话签名密钥（必填，>= 32 字符随机串）
#    生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="please-change-me-to-a-random-32-byte-string"

# ---------------------------------------------------------------------------
# 3) 大模型（OpenAI 兼容接口）——用于长难句讲解、难词释义、划词翻译
#    兼容：DeepSeek / OpenAI / 通义千问 / Moonshot / 本地 Ollama(v1) 等
#    留空 LLM_API_KEY => 自动进入离线降级模式（内置词库 + 规则分析），流程仍可跑通
# ---------------------------------------------------------------------------
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
LLM_TIMEOUT_MS="45000"

# ---------------------------------------------------------------------------
# 4) 翻译兜底（可选）：LLM 不可用时可再试 LibreTranslate
# ---------------------------------------------------------------------------
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""

# ---------------------------------------------------------------------------
# 5) 上传文件存储目录（相对项目根目录）。生产环境建议换成对象存储/持久磁盘
# ---------------------------------------------------------------------------
STORAGE_DIR="./data/uploads"
MAX_UPLOAD_MB="50"

# ---------------------------------------------------------------------------
# 6) 离线词典（可选）：ECDICT → SQLite
#    生成：node scripts/import-ecdict.mjs --csv data/ecdict.csv
#    存在时优先用于：释义 / 音标 / 难度分级；不存在则回退内置小词表
# ---------------------------------------------------------------------------
DICT_DB_PATH="./data/ecdict.db"
