# 复制为 .env 后修改：cp .env.production.example .env
# 注意：这个文件里是服务器配置，不要提交到 Git（.gitignore 已忽略）

# 你的域名（DNS A 记录指向服务器公网 IP）；没有域名可先填 localhost 用 IP:80 访问
SITE_ADDRESS="books.example.com"

# 多用户模式（服务器上必须开）
AUTH_MODE="multi"
# 32+ 位随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-32-byte-string"

# 数据目录（容器内绝对路径，挂载在 app_data 卷）
DATABASE_URL="file:/app/data/app.db"
STORAGE_DIR="/app/data/uploads"
DICT_DB_PATH="/app/data/ecdict.db"
MAX_UPLOAD_MB="50"

# 大模型：服务器没有 GPU 时建议用云 API（30 人规模每月约 10–30 元）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
LLM_TIMEOUT_MS="30000"

# 可选：二级翻译兜底
LIBRETRANSLATE_URL=""
